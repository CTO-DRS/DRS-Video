<?xml version="1.0" encoding="utf-8"?>
<!-- DRS Video FileProvider paths (v1.12.0).
     cache-path/update/ → staged self-update APKs handed to the
     system package installer. files-path/ root → captured frames
     and other shareable app-internal files. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="update" path="update/" />
    <files-path name="files" path="." />
    <external-files-path name="external_files" path="." />
</paths>
